# XAMPP / shared hosting: when the project folder itself is the web root,
# send every request into public/ so nothing else can be reached.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
