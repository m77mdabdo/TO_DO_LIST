# Copy this file to .env and fill in your own values. .env is ignored by git.

APP_URL=http://localhost:8000

# log = write emails to storage/mail (nothing is sent) | smtp | mail
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@example.com
# For Gmail, use an app password (Google account > Security > App passwords), not your normal password.
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=you@example.com
MAIL_FROM_NAME="To Do List"
